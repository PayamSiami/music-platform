# Firebase Web App registration values (Firebase console > Project settings > Your apps > Web).
# Copy this file to `.env` and fill in the real values. `.env.local` is gitignored.
# Docs: https://docs.expo.dev/guides/environment-variables/
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=divacast.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=divacast
